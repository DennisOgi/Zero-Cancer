DATABASE_URL=
DIRECT_URL=""
JWT_TOKEN_SECRET="your_jwt_secret_key30928476890"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:3000
ENV_MODE=development
# Flutterwave (https://dashboard.flutterwave.com/dashboard/settings/apis)
# Set these as Cloudflare Worker secrets in production. Never commit real keys.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_test_secret_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_test_public_key
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_secret_hash
# Optional leftover Paystack keys for in-flight Paystack webhooks only.
# PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
# PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key
CRON_API_KEY=your_cron_api_key_here_for_reaaaallllll?
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Patient registration photo uploads use the backend Cloudinary credentials above.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
WAITLIST_GEOGRAPHIC_TARGETING=true
WAITLIST_DEMOGRAPHIC_TARGETING=true

# Please note, that to run the cloudflare worker, you need to set the following variables 
# in .dev.vars file in the root of the backend folder project
# https://developers.cloudflare.com/workers/configuration/environment-variables/